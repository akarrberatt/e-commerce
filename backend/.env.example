# Sunucu
NODE_ENV=development
PORT=8000

# Frontend adresi (CORS ve e-postadaki doğrulama linki için)
FRONTEND_URL=http://localhost:5173

# PostgreSQL bağlantısı
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce

# JWT (en az 32 karakter, rastgele bir değer kullan)
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=buraya-uzun-rastgele-bir-deger-yaz
ACCESS_TOKEN_TTL=15m

# Refresh token ve e-posta doğrulama süreleri
REFRESH_TOKEN_TTL_DAYS=7
EMAIL_VERIFICATION_TTL_HOURS=24

# Production'da (HTTPS) true olmalı
COOKIE_SECURE=false

# SMTP (boş bırakılırsa doğrulama linki konsola yazdırılır)
# docker-compose ile gelen Mailpit için: SMTP_HOST=localhost, SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="E-Commerce <no-reply@example.com>"
