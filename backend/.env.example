# Sunucu
NODE_ENV=development
PORT=8000

# Frontend adresi (CORS ve e-postadaki doğrulama linki için)
FRONTEND_URL=http://localhost:5173

# PostgreSQL bağlantısı
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce

# JWT (en az 32 karakter, rastgele bir değer kullan)
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=buraya-uzun-rastgele-bir-deger-yaz
ACCESS_TOKEN_TTL=15m

# Refresh token ve e-posta doğrulama süreleri
REFRESH_TOKEN_TTL_DAYS=7
EMAIL_VERIFICATION_TTL_HOURS=24

# Şifre sıfırlama bağlantısının geçerlilik süresi
PASSWORD_RESET_TTL_MINUTES=60

# Rotate edilmiş refresh token'ın tekrar kabul edildiği süre (iki sekme aynı anda yenilerse)
REFRESH_GRACE_SECONDS=30

# Kayıtta onaylanan Kullanım Şartları / Gizlilik Politikası sürümü (metin değişince artır)
TERMS_VERSION=1.0

# Google ile giriş (Google Cloud Console > APIs & Services > Credentials > OAuth client ID)
# Yetkili yönlendirme URI'si olarak GOOGLE_REDIRECT_URI değerini ekle.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Production'da (HTTPS) true olmalı
COOKIE_SECURE=false

# SMTP (boş bırakılırsa doğrulama linki konsola yazdırılır)
# docker-compose ile gelen Mailpit için: SMTP_HOST=localhost, SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="E-Commerce <no-reply@example.com>"
